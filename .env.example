# Copy to .env and fill in. .env is gitignored.
DEEPSEEK_API_KEY=
AGENT_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-flash
# The second reader's model, which reviews every document before it goes (`same` for AGENT_MODEL).
AGENT_REVIEW_MODEL=deepseek-v4-pro
# The bot (apps/bot):
TELEGRAM_BOT_TOKEN=
# Telegram user ids allowed to use the bot, comma-separated.
BOT_ALLOWED_USERS=
# Whom someone not on the list is told to write to, to be added (e.g. a name and an @username)
BOT_CONTACT=
# The bot's whole allowance across every person, in US dollars.
BOT_GLOBAL_LIMIT_USD=5
