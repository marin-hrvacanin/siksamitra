# === Node ===
node_modules/
dist/
build/
*.tsbuildinfo
.vite/

# === Rust / Tauri ===
target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/binaries/*
!apps/desktop/src-tauri/binaries/.gitkeep

# === Python (tools/ sidecars) ===
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# === User data (never in the repo) ===
Library/
media/
cache/
preferences.json

# === Legacy v1 leftovers that survive a branch switch ===
Untitled.html
test_dirgham.html
combiningMark.html
*_original.html
icon_data_uri*.txt
icon_old.ico
logo_old.png
debug.log
*.log
documents/
tests/
specs/
śikṣāmitra/

# Fonts are vendored in assets/fonts and COPIED into the app at build
# time. One source of truth; the copy is build output.
apps/web/public/fonts/

# === Generated previews ===
design-preview.html
shots/
.shots/

# === Portable packages are build output, not source ===
*.vuchant
*.smdoc

# === Claude Code local config ===
# CLAUDE.md is COMMITTED: it is the map a contributor or agent needs on clone.
# Only machine-local settings are ignored.
.claude/settings.local.json

# === OS / editor ===
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
*.code-workspace

# Declaration output that lands next to a source file. It should never be
# there — it means a project emitted with the wrong rootDir — but ignoring it
# stops one bad invocation committing 40 generated files, which happened.
src/**/*.d.ts
src/**/*.d.ts.map
dist-types/
