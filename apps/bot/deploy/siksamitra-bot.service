# śikṣāmitra Telegram bot — systemd unit. Installed by apps/bot/deploy/install.sh.
#
# The secrets are in /etc/siksamitra/bot.env (root:siksamitra, 0640), outside
# the code's folder: the checkout in /opt/siksamitra never holds a key, and the
# service user can read the key but not change it. The bot needs no open port —
# it polls Telegram — so nothing on the server listens for it.
[Unit]
Description=śikṣāmitra Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=siksamitra
Group=siksamitra
WorkingDirectory=/opt/siksamitra
EnvironmentFile=/etc/siksamitra/bot.env
Environment=NODE_ENV=production
Environment=BOT_DATA_DIR=/var/lib/siksamitra
ExecStart=/opt/siksamitra/node_modules/.bin/tsx --tsconfig tools/export/tsconfig.render.json --import ./tools/export/no-css.mjs apps/bot/src/telegram.ts
Restart=on-failure
RestartSec=15

# What it may touch: its own data, and nothing else of the machine.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/siksamitra
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
MemoryMax=2G

[Install]
WantedBy=multi-user.target
