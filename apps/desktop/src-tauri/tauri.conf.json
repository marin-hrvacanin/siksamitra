{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "siksamitra",
  "version": "2.0.0-alpha.0",
  "identifier": "org.siksamitra.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run -w @siksamitra/web dev",
    "beforeBuildCommand": "npm run -w @siksamitra/web build"
  },
  "app": {
    "windows": [
      {
        "title": "śikṣāmitra",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "theme": null
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "A workbench for Vedic and classical Sanskrit text",
    "longDescription": "Read, author and export siksa-marked Sanskrit recitation text — holdings, svaras, anusvara and visarga — in IAST, Devanagari, Telugu and Tamil. Works entirely offline. Every font it needs is inside the application.",
    "copyright": "© Marin Hrvacanin. SIL OFL fonts bundled; see LICENSES.",
    "publisher": "siksamitra",
    "fileAssociations": [
      {
        "ext": ["vuchant"],
        "name": "Chant package",
        "description": "A chant document with its sources, audio and figures",
        "role": "Editor",
        "mimeType": "application/vnd.siksamitra.chant+zip"
      },
      {
        "ext": ["smdoc"],
        "name": "siksamitra v1 document",
        "description": "A document from siksamitra v1",
        "role": "Viewer",
        "mimeType": "application/vnd.siksamitra.v1"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": { "x": 180, "y": 200 },
        "applicationFolderPosition": { "x": 480, "y": 200 },
        "windowSize": { "width": 660, "height": 400 }
      }
    },
    "linux": {
      "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {}
}
