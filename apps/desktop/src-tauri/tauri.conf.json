{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "siksamitra",
  "version": "2.0.0-alpha.0",
  "identifier": "org.siksamitra.app",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run -w @siksamitra/web dev",
    "beforeBuildCommand": "npm run -w @siksamitra/web build"
  },
  "app": {
    "windows": [
      {
        "title": "śikṣāmitra",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "theme": null,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://vedaunion.org",
        "img-src": "'self' data: blob:",
        "media-src": "'self' blob:",
        "font-src": "'self' data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "A workbench for Vedic and classical Sanskrit text",
    "longDescription": "Read, author and export siksa-marked Sanskrit recitation text — holdings, svaras, anusvara and visarga — in IAST, Devanagari, Telugu and Tamil. Works entirely offline. Every font it needs is inside the application.",
    "copyright": "© Marin Hrvacanin. SIL OFL fonts bundled; see LICENSES.",
    "publisher": "siksamitra",
    "fileAssociations": [
      {
        "ext": [
          "smdoc"
        ],
        "name": "siksamitra document",
        "description": "A siksamitra document: marked recitation text with its sources",
        "role": "Editor",
        "mimeType": "application/vnd.siksamitra.document+zip",
        "rank": "Owner",
        "exportedType": {
          "identifier": "org.siksamitra.document",
          "conformsTo": [
            "public.data",
            "public.composite-content"
          ]
        }
      },
      {
        "ext": [
          "vuchant"
        ],
        "name": "siksamitra chant package",
        "description": "A chant document with its sources, audio and figures",
        "role": "Editor",
        "mimeType": "application/vnd.siksamitra.chant+zip",
        "rank": "Owner",
        "exportedType": {
          "identifier": "org.siksamitra.chant",
          "conformsTo": [
            "public.data",
            "public.composite-content"
          ]
        }
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "windows/associations.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 200
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "files": {
          "/usr/share/mime/packages/org.siksamitra.document.xml": "linux/org.siksamitra.document.xml",
          "/usr/share/icons/hicolor/32x32/mimetypes/application-vnd.siksamitra.document+zip.png": "icons/document-32.png",
          "/usr/share/icons/hicolor/64x64/mimetypes/application-vnd.siksamitra.document+zip.png": "icons/document-64.png",
          "/usr/share/icons/hicolor/128x128/mimetypes/application-vnd.siksamitra.document+zip.png": "icons/document-128.png",
          "/usr/share/icons/hicolor/256x256/mimetypes/application-vnd.siksamitra.document+zip.png": "icons/document-256.png",
          "/usr/share/icons/hicolor/512x512/mimetypes/application-vnd.siksamitra.document+zip.png": "icons/document-512.png"
        }
      }
    },
    "createUpdaterArtifacts": false,
    "resources": {
      "icons/document.ico": "resources/icons/document.ico",
      "icons/document-512.png": "resources/icons/document-512.png"
    }
  },
  "plugins": {}
}
