{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "noEmit": true,
    "paths": {
      "@siksamitra/account": [
        "../../packages/account/src/index.ts"
      ],
      "@siksamitra/audio": [
        "../../packages/audio/src/index.ts"
      ],
      "@siksamitra/edit": [
        "../../packages/edit/src/index.ts"
      ],
      "@siksamitra/engine": [
        "../../packages/engine/src/index.ts"
      ],
      "@siksamitra/format": [
        "../../packages/format/src/index.ts"
      ],
      "@siksamitra/interop": [
        "../../packages/interop/src/index.ts"
      ],
      "@siksamitra/layout": [
        "../../packages/layout/src/index.ts"
      ],
      "@siksamitra/render": [
        "../../packages/render/src/index.ts"
      ],
      "@siksamitra/storage": [
        "../../packages/storage/src/index.ts"
      ],
      "@siksamitra/tokens": [
        "../../packages/tokens/generated/tokens.ts"
      ],
      "@siksamitra/tokens/word": [
        "../../packages/tokens/src/word.ts"
      ]
    },
    "types": [
      "vite/client"
    ],
    "composite": false,
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "src/**/*"
  ]
}
