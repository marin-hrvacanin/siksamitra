  <Version>2.0.0.0</Version>
  <ProviderName>Veda Union</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="śikṣāmitra"/>
  <Description DefaultValue="Mark Vedic recitation text in Word: holdings, svaras, reading aids and pauses, in the same notation and the same styles as the śikṣāmitra editor."/>
  <IconUrl DefaultValue="https://localhost:3000/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/icon-80.png"/>
  <SupportUrl DefaultValue="https://marin-hrvacanin.github.io/siksamitra/#word"/>

  <AppDomains>
    <AppDomain>https://localhost:3000</AppDomain>
    <AppDomain>https://vedaunion.org</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document"/>
  </Hosts>

  <!--
    WordApi 1.3 is the floor, and it is chosen rather than inherited:
    `Range.expandTo` and `Range.getRange` are what measure where the selection
    starts inside its paragraph, and they arrived in 1.3. Everything else the
    add-in uses — `getOoxml`, `insertOoxml` — is 1.1. 1.3 is Word 2019 on the
    desktop, Word for Mac 15.32, and every version of Word on the web.
  -->
  <Requirements>
    <Sets DefaultMinVersion="1.3">
      <Set Name="WordApi" MinVersion="1.3"/>
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:3000/taskpane.html"/>
  </DefaultSettings>

  <!-- The add-in writes the paragraph the caret is in. Nothing less will do. -->
  <Permissions>ReadWriteDocument</Permissions>

