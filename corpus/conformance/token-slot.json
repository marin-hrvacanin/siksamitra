    "instructions": [
      {
        "kind": "option",
        "text": {
          "en": "If any of the offerings is not available, you can use akṣatas instead."
        }
      },
      {
        "kind": "note",
        "text": {
          "en": "Throughout the rite the right hand acts towards the deity and the left anchors you: the right offers, holds the spoon and pours. The left rings the bell or rests on your own heart, and it pours only once — into your own right palm at ācamanam, which is purification and not an offering."
        }
      },
      {
        "kind": "note",
        "text": {
          "en": "What is offered is measured against your means, not against the size of the image. A leaf, a flower, a fruit, water — given with devotion, that is the offering."
        }
      },
      {
        "kind": "note",
        "text": {
          "en": "Deva may be substituted by any other deity, such as Mahāgaṇapati, Mahāviṣṇu, Mahāsarasvatī or Mahālakṣmī. Choose the deity once, in the reader settings, and it is named throughout — in the saṅkalpa and in the mantras of invocation."
        }
      }
    ],
