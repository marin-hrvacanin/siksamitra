{
  "name": "siksamitra",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "śikṣāmitra — the editor for Vedic and classical Sanskrit recitation text. v2.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/tokens",
    "packages/format",
    "packages/engine",
    "packages/layout",
    "packages/render",
    "packages/interop",
    "packages/storage",
    "packages/cli",
    "apps/web",
    "apps/desktop"
  ],
  "scripts": {
    "build": "npm-run-all --serial build:format build:engine build:interop build:layout build:storage build:render build:cli",
    "build:format": "npm run -w @siksamitra/format build",
    "build:engine": "npm run -w @siksamitra/engine build",
    "build:interop": "npm run -w @siksamitra/interop build",
    "build:render": "npm run -w @siksamitra/render build",
    "build:cli": "npm run -w @siksamitra/cli build",
    "dev": "npm run -w @siksamitra/web dev",
    "desktop:dev": "npm run -w @siksamitra/desktop dev",
    "desktop:build": "npm run -w @siksamitra/desktop build",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest --project unit --project component",
    "sm": "tsx packages/cli/src/main.ts",
    "check": "npm-run-all --serial typecheck test check:modules check:tokens check:literals check:fixtures check:conformance check:transliteration check:lossless check:engine",
    "check:transliteration": "tsx packages/cli/src/gates/transliteration.ts",
    "check:engine": "tsx packages/cli/src/gates/corpus.ts",
    "spec": "openspec",
    "check:conformance": "tsx packages/cli/src/gates/conformance.ts",
    "gen:conformance": "tsx tools/build-conformance.mjs",
    "check:fixtures": "tsx tools/build-conformance.mjs --check",
    "gen:tokens": "tsx packages/tokens/gen.mjs",
    "check:tokens": "tsx packages/tokens/gen.mjs --check",
    "check:literals": "node tools/check-tokens.mjs",
    "build:storage": "npm run -w @siksamitra/storage build",
    "check:lossless": "tsx packages/cli/src/gates/lossless.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:component": "vitest run --project component",
    "test:security": "vitest run --project security",
    "build:layout": "npm run -w @siksamitra/layout build",
    "check:modules": "node tools/check-modules.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.12.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
