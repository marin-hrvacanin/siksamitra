{
  "name": "siksamitra",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "śikṣāmitra — the editor for Vedic and classical Sanskrit recitation text. v2.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/tokens",
    "packages/format",
    "packages/engine",
    "packages/layout",
    "packages/audio",
    "packages/account",
    "packages/edit",
    "packages/render",
    "packages/interop",
    "packages/storage",
    "packages/cli",
    "apps/web",
    "apps/desktop",
    "apps/word-addin"
  ],
  "scripts": {
    "build": "npm-run-all --serial build:format build:engine build:edit build:interop build:layout build:audio build:account build:storage build:render build:cli",
    "build:format": "npm run -w @siksamitra/format build",
    "build:engine": "npm run -w @siksamitra/engine build",
    "build:interop": "npm run -w @siksamitra/interop build",
    "build:render": "npm run -w @siksamitra/render build",
    "build:cli": "npm run -w @siksamitra/cli build",
    "dev": "npm run -w @siksamitra/web dev",
    "desktop:dev": "npm run -w @siksamitra/desktop dev",
    "desktop:build": "npm run -w @siksamitra/desktop build",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest --project unit --project component",
    "sm": "tsx packages/cli/src/main.ts",
    "check": "npm-run-all --serial typecheck check:web check:word-addin test check:icons check:authoring check:modules check:open check:tokens check:literals check:fixtures check:conformance check:marking check:migrate check:size check:source check:transliteration check:lossless check:engine check:export:html check:export:image check:export:figures check:export:word check:export:pdf",
    "check:transliteration": "tsx packages/cli/src/gates/transliteration.ts",
    "check:engine": "tsx packages/cli/src/gates/corpus.ts",
    "spec": "openspec",
    "check:conformance": "tsx packages/cli/src/gates/conformance.ts",
    "gen:conformance": "tsx tools/build-conformance.mjs",
    "check:fixtures": "tsx tools/build-conformance.mjs --check",
    "gen:tokens": "tsx packages/tokens/gen.mjs",
    "check:tokens": "tsx packages/tokens/gen.mjs --check",
    "check:literals": "node tools/check-tokens.mjs",
    "build:storage": "npm run -w @siksamitra/storage build",
    "check:lossless": "tsx packages/cli/src/gates/lossless.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:component": "vitest run --project component",
    "test:security": "vitest run --project security",
    "build:layout": "npm run -w @siksamitra/layout build",
    "check:modules": "node tools/check-modules.mjs",
    "run": "node scripts/run.mjs",
    "build:web": "npm run -w @siksamitra/web build && node tools/build-stamp.mjs --write apps/web/dist",
    "design": "tsx tools/design/preview.mjs",
    "fonts": "node tools/fonts/fetch.mjs && node tools/fonts/gen-css.mjs",
    "fonts:css": "node tools/fonts/gen-css.mjs",
    "check:fonts": "node tools/fonts/verify.mjs",
    "package": "node scripts/package.mjs",
    "copy:fonts": "node scripts/copy-fonts.mjs",
    "desktop:icons": "npm run -w @siksamitra/desktop icons",
    "build:edit": "npm run -w @siksamitra/edit build",
    "check:web": "npm run build:web",
    "check:word-addin": "npm run -w @siksamitra/word-addin build",
    "check:edit": "npm-run-all --serial check:edit:gestures check:edit:figure check:edit:views check:edit:ribbon check:edit:audio check:edit:zoom check:edit:typing check:edit:pages check:reflow",
    "check:reflow": "node tools/no-reflow.mjs",
    "check:marking": "tsx tools/adopt-safety.mjs",
    "check:migrate": "tsx tools/migrate-audit.mjs",
    "check:run-parity": "tsx --tsconfig tools/export/tsconfig.render.json --import ./tools/export/no-css.mjs tools/run-parity.mjs",
    "check:source": "tsx packages/cli/src/gates/source.ts",
    "check:document": "tsx tools/doc-fidelity.mjs",
    "icons": "node tools/icons/gen.mjs",
    "check:icons": "node tools/icons/gen.mjs --check",
    "check:responsive": "node tools/responsive.mjs",
    "check:themes": "tsx tools/theme-matrix.mjs",
    "check:authoring": "node tools/check-authoring.mjs",
    "sync:authoring": "node tools/check-authoring.mjs --sync",
    "build:audio": "npm run -w @siksamitra/audio build",
    "build:account": "npm run -w @siksamitra/account build",
    "perf:selection": "node tools/perf-selection.mjs",
    "check:edit:gestures": "node tools/interaction.mjs",
    "check:edit:figure": "node tools/interaction-figure.mjs",
    "check:edit:views": "node tools/interaction-views.mjs",
    "check:edit:ribbon": "node tools/interaction-ribbon.mjs",
    "check:edit:audio": "node tools/interaction-audio.mjs",
    "check:edit:zoom": "node tools/interaction-zoom.mjs",
    "check:edit:typing": "node tools/interaction-typing.mjs",
    "check:edit:pages": "node tools/interaction-pages.mjs",
    "export": "tsx --tsconfig tools/export/tsconfig.render.json --import ./tools/export/no-css.mjs tools/export/cli.mjs",
    "check:export:html": "tsx --tsconfig tools/export/tsconfig.render.json --import ./tools/export/no-css.mjs tools/export/gate-html.mjs",
    "check:export:image": "tsx --tsconfig tools/export/tsconfig.render.json --import ./tools/export/no-css.mjs tools/export/gate-image.mjs",
    "check:export:figures": "tsx --tsconfig tools/export/tsconfig.render.json --import ./tools/export/no-css.mjs tools/export/gate-figures.mjs",
    "check:export:word": "tsx --tsconfig tools/export/tsconfig.render.json --import ./tools/export/no-css.mjs tools/export/gate-word.mjs",
    "check:export:pdf": "tsx --tsconfig tools/export/tsconfig.render.json --import ./tools/export/no-css.mjs tools/export/gate-pdf.mjs",
    "check:size": "node tools/size.mjs",
    "check:open": "node tools/check-open.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.12.0",
    "@material-symbols/svg-400": "^0.47.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.2",
    "iconoir": "^7.12.1",
    "jsdom": "^25.0.1",
    "npm-run-all": "^4.1.5",
    "puppeteer-core": "^25.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
